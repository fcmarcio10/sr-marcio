{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BR Night Drive",
  "mainBinaryName": "BR Night Drive",
  "version": "1.7.0",
  "identifier": "com.brnightdrive.game",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BR Night Drive",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "zoomHotkeysEnabled": false,
        "backgroundColor": "#05070f"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BR Night Drive",
    "copyright": "© 2026 BR Night Drive",
    "category": "Game",
    "shortDescription": "BR Night Drive",
    "longDescription": "Dirija pela noite de São Gambiarra, ES.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
